{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "npm install --include=dev",
  "functions": {
    "server.ts": {
      "maxDuration": 30,
      "includeFiles": "{models/**,public/**,node_modules/onnxruntime-node/bin/napi-v6/linux/x64/**}",
      "excludeFiles": "{Dataset/**,data/storage/**,node_modules/onnxruntime-node/bin/napi-v6/darwin/**,node_modules/onnxruntime-node/bin/napi-v6/win32/**,node_modules/onnxruntime-node/bin/napi-v6/linux/arm64/**,**/*.mp4}"
    },
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": "{models/**,public/**,node_modules/onnxruntime-node/bin/napi-v6/linux/x64/**}",
      "excludeFiles": "{Dataset/**,data/storage/**,node_modules/onnxruntime-node/bin/napi-v6/darwin/**,node_modules/onnxruntime-node/bin/napi-v6/win32/**,node_modules/onnxruntime-node/bin/napi-v6/linux/arm64/**,**/*.mp4}"
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/index" },
    { "source": "/login", "destination": "/api/index" },
    { "source": "/login/", "destination": "/api/index" },
    { "source": "/signin", "destination": "/api/index" },
    { "source": "/login.html", "destination": "/api/index" },
    { "source": "/portal", "destination": "/api/index" },
    { "source": "/portal/", "destination": "/api/index" },
    { "source": "/dashboard", "destination": "/api/index" },
    { "source": "/app", "destination": "/api/index" },
    { "source": "/traffic", "destination": "/api/index" },
    { "source": "/heatmap", "destination": "/api/index" },
    { "source": "/vision", "destination": "/api/index" },
    { "source": "/live_traffic", "destination": "/api/index" },
    { "source": "/live-traffic", "destination": "/api/index" },
    { "source": "/monitor", "destination": "/api/index" },
    { "source": "/predict", "destination": "/api/index" },
    { "source": "/decide", "destination": "/api/index" },
    { "source": "/synthesizer", "destination": "/api/index" },
    { "source": "/synthesizer/", "destination": "/api/index" },
    { "source": "/guides/(.*)", "destination": "/api/index" },
    { "source": "/architecture/(.*)", "destination": "/api/index" },
    { "source": "/health", "destination": "/api/index" },
    { "source": "/api/(.*)", "destination": "/api/index" }
  ]
}
