# Server
PORT=3000
NODE_ENV=development
PERSISTENT_DATA_DIR=

# Authentication (change credentials before deploying to production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
SESSION_TTL_SECONDS=43200

# External APIs (optional — falls back cleanly when omitted)
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_MAP_ID=
TOMTOM_API_KEY=
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast